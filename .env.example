# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# AVERION provider profile is fail-closed. Set to `upstream` only to restore
# the original OpenReply product defaults (open signup, automations on,
# human inbox send on, insights OAuth scope).
OPENREPLY_PROVIDER_PROFILE=averion

# Required in production for the AVERION profile. Empty or unset means the
# process is not production-ready and sign-in admits nobody. Comma separated,
# case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Automation kill switch. false: webhooks may still be verified and stored,
# but no comment, DM-keyword, or postback jobs are queued, polling
# reconciliation does not enqueue, and the worker does not send. The worker
# process itself stays up. Default false on the AVERION profile.
OPENREPLY_AUTOMATIONS_ENABLED=false

# Human inbox send (POST /api/instagram/conversations). false blocks dashboard
# sends. Conversation ingest and read stay available. Full ingress control
# (private network) is Wave 2B; this is the code-side gate. Default false on
# the AVERION profile.
OPENREPLY_HUMAN_SEND_ENABLED=false

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
