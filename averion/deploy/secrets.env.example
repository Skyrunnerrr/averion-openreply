# Example only. check-readiness.mjs rejects these placeholder values.
# Copy to secrets.env on the orchestrator host. Never commit secrets.env.

NODE_ENV=production
NEXTAUTH_URL=https://openreply.example
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-different-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_URL=postgresql://openreply:replace-with-password@postgres:5432/openreply
REDIS_URL=redis://:replace-with-password@redis:6379
EMAIL_FROM=OpenReply <login@example.com>
RESEND_API_KEY=re_...
ALLOWED_EMAILS=
OPENREPLY_PROVIDER_PROFILE=averion
OPENREPLY_AUTOMATIONS_ENABLED=false
OPENREPLY_HUMAN_SEND_ENABLED=false
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
META_GRAPH_API_VERSION=v25.0
